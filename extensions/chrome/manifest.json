{
  "manifest_version": 3,
  "name": "MockFrame Capture",
  "version": "0.1.0",
  "description": "Capture the visible tab and continue editing it in MockFrame.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "Capture with MockFrame",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mockframe.app/*", "http://localhost:3000/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
